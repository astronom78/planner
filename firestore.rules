rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Каждый пользователь читает и меняет только свои данные
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Старые общие коллекции (до входа через Google): только владельцу планнера, для переноса данных
    match /{legacy}/{id} {
      allow read: if legacy in ['projects', 'stages', 'tasks', 'meetings', 'attachments']
        && request.auth != null && request.auth.token.email == 'lizok3546@gmail.com';
    }
  }
}
